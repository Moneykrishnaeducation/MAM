    "apps/server/.env.example": "# Environment Configuration\n# Copy this file to .env and update the values\n\n# Application\nDEBUG=true\nHOST=0.0.0.0\nPORT=8000\n\n# Allowed web origin for CORS (unset or empty = allow any origin)\nCORS_ORIGIN=http://localhost:3001\n\n# Database (if using SQLAlchemy/SQLModel)\nDATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/MAM\n\n# OpenAI (if using AI frameworks)\nOPENAI_API_KEY=your-openai-api-key\n\n# Anthropic (if using Anthropic SDK)\nANTHROPIC_API_KEY=your-anthropic-api-key\n\n# Confluent Kafka\nKAFKA_BOOTSTRAP_SERVERS=localhost:9092\n\n# Celery (if using task queue)\nCELERY_BROKER_URL=redis://localhost:6379/0\nCELERY_RESULT_BACKEND=redis://localhost:6379/0\n\n# FastAPI Users\nAUTH_SECRET=change-me-to-a-real-secret\nUSERS_DATABASE_URL=sqlite+aiosqlite:///./users.db\n",
    "apps/web/package.json": "{\n  \"name\": \"web\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"check-types\": \"tsc --noEmit\",\n    \"dev\": \"next dev --port 3001\",\n    \"build\": \"next build\",\n    \"start\": \"next start\",\n    \"tauri\": \"tauri\",\n    \"tauri:dev\": \"tauri dev\",\n    \"tauri:build\": \"tauri build\",\n    \"desktop:dev\": \"tauri dev\",\n    \"desktop:build\": \"tauri build\"\n  },\n  \"dependencies\": {\n    \"@base-ui/react\": \"^1.6.0\",\n    \"class-variance-authority\": \"^0.7.1\",\n    \"clsx\": \"^2.1.1\",\n    \"next-themes\": \"^0.4.6\",\n    \"sonner\": \"^2.0.7\",\n    \"tailwind-merge\": \"^3.6.0\",\n    \"shadcn\": \"^4.14.1\",\n    \"@tanstack/react-form\": \"^1.33.0\",\n    \"tw-animate-css\": \"^1.4.0\",\n    \"next\": \"catalog:\",\n    \"react\": \"catalog:\",\n    \"react-dom\": \"catalog:\",\n    \"babel-plugin-react-compiler\": \"^1.0.0\",\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@MAM/env\": \"workspace:*\",\n    \"axios\": \"^1.18.1\",\n    \"@tauri-apps/api\": \"^2.11.1\",\n    \"@reduxjs/toolkit\": \"^2.12.0\",\n    \"react-redux\": \"^9.3.0\",\n    \"@formkit/auto-animate\": \"^0.9.0\",\n    \"radix-ui\": \"^1.6.7\",\n    \"lucide-react\": \"^1.21.0\",\n    \"@fontsource-variable/inter\": \"^5.3.0\",\n    \"arktype\": \"^2.2.3\"\n  },\n  \"devDependencies\": {\n    \"@tailwindcss/postcss\": \"catalog:\",\n    \"tailwindcss\": \"catalog:\",\n    \"@types/node\": \"catalog:\",\n    \"@types/react\": \"catalog:\",\n    \"@types/react-dom\": \"catalog:\",\n    \"typescript\": \"^5\",\n    \"@MAM/config\": \"workspace:*\",\n    \"@tauri-apps/cli\": \"^2.11.4\",\n    \"@playwright/test\": \"^1.62.0\",\n    \"playwright\": \"^1.62.0\"\n  }\n}\n",
    "package.json": "{\n  \"name\": \"MAM\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": {\n    \"packages\": [\n      \"apps/*\",\n      \"packages/*\"\n    ],\n    \"catalog\": {\n      \"dotenv\": \"^17.4.2\",\n      \"zod\": \"^4.4.3\",\n      \"next\": \"^16.2.10\",\n      \"react\": \"^19.2.8\",\n      \"react-dom\": \"^19.2.8\",\n      \"@tailwindcss/postcss\": \"^4.3.3\",\n      \"tailwindcss\": \"^4.3.3\",\n      \"@types/node\": \"^26.1.1\",\n      \"@types/react\": \"^19.2.17\",\n      \"@types/react-dom\": \"^19.2.3\",\n      \"@types/bun\": \"^1.3.14\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"turbo -F web dev\",\n    \"build\": \"turbo build\",\n    \"check-types\": \"turbo check-types\",\n    \"dev:web\": \"turbo -F web dev\",\n    \"dev:docs\": \"turbo -F docs dev\",\n    \"build:docs\": \"turbo -F docs build\",\n    \"check:docs\": \"turbo -F docs check-types\",\n    \"dev:server\": \"cd apps/server && uv run python src/app/main.py\",\n    \"setup:server\": \"cd apps/server && uv sync --extra dev\",\n    \"check:server\": \"cd apps/server && uv run --extra dev ruff check .\",\n    \"test:server\": \"cd apps/server && uv run --extra dev pytest\"\n  },\n  \"packageManager\": \"bun@1.3.5\",\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@MAM/env\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^6.0.3\",\n    \"@MAM/config\": \"workspace:*\",\n    \"turbo\": \"^2.10.0\",\n    \"@types/bun\": \"catalog:\"\n  }\n}\n",
    "packages/config/package.json": "{\n  \"name\": \"@MAM/config\",\n  \"version\": \"0.0.0\",\n  \"private\": true\n}\n",
    "packages/env/package.json": "{\n  \"name\": \"@MAM/env\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"exports\": {\n    \"./web\": \"./src/web.ts\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@t3-oss/env-nextjs\": \"^0.13.11\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^6.0.3\",\n    \"@MAM/config\": \"workspace:*\",\n    \"@types/bun\": \"catalog:\"\n  }\n}\n"
  }
